###  http://kai.cs.vu.nl/2024/situated-minor-project/hotel#Nationality
ns1:Nationality rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty [ owl:inverseOf ns1:nationality
                                                     ] ;
                                      owl:someValuesFrom owl:Thing
                                    ] ;
                rdfs:label "Nationality" .


